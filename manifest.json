{
  "manifest_version": 2,
  "name": "Extensão ChatGPT",
  "version": "1.0",
  "description": "Extensão que envia comandos contínuos para o ChatGPT.",
  "permissions": [
    "activeTab",
    "background"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3002/*"
    ]
  },
  "background": {
    "scripts": [
      "src/background/background.ts"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "src/pages/index.html",
    "default_icon": {
      "16": "public/favicon.ico",
      "48": "public/favicon.ico",
      "128": "public/favicon.ico"
    }
  },
  "icons": {
    "16": "public/favicon.ico",
    "48": "public/favicon.ico",
    "128": "public/favicon.ico"
  }
}
